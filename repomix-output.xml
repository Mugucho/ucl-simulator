import datetime

# 4. Lógica de Pestañas
if tab_selection == "Latest Games":
    
    # ---------------------------------------------------------
    # A. LÓGICA DE FECHAS PARA EL SELECTOR
    # ---------------------------------------------------------
    # Como el CSV solo tiene la "Temporada", usamos la fecha exacta de 
    # la última final registrada (Man City vs Inter: 10 de Junio de 2023)
    ultima_fecha = datetime.date(2023, 6, 10)
    hace_un_mes = ultima_fecha - datetime.timedelta(days=30)

    col3, col4 = st.columns([4, 1])
    with col3:
        st.markdown("## Latest games")
    with col4:
        # st.date_input ahora recibe un rango (start_date, end_date)
        st.date_input(
            "Select date range", 
            value=(hace_un_mes, ultima_fecha), 
            label_visibility="collapsed"
        )
        
    # ---------------------------------------------------------
    # B. GENERACIÓN DINÁMICA DE TARJETAS (HTML)
    # ---------------------------------------------------------
    ultimos_juegos = df_finals.tail(4).iloc[::-1]
    
    colores_borde = ["#f59e0b", "#3b82f6", "#8b5cf6", "#ef4444"]
    
    cards_html = '<div class="horizontal-scroll">\\n'
    
    for idx, (_, row) in enumerate(ultimos_juegos.iterrows()):
        color = colores_borde[idx % len(colores_borde)]
        ganador = row['Winners']
        goles_ganador = row['Winner_Goals']
        perdedor = row['Runners-up']
        goles_perdedor = row['RunnerUp_Goals']
        temporada = row['Season']
        
        # CERO espacios al inicio de cada línea dentro de las comillas
        cards_html += f"""<div class="game-card" style="border-left: 4px solid {color};">
