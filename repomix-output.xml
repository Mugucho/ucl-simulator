<div style="display: flex; justify-content: space-between; color: #4b5563;">
<span>{perdedor}</span><span>{goles_perdedor}</span>
</div>
</div>
"""
        
    cards_html += '</div>'
    
    st.markdown(cards_html, unsafe_allow_html=True)
    
    
    # ---------------------------------------------------------
    # C. SIMULACIONES MONTE CARLO: PROYECCIÓN 2025-2026
    # ---------------------------------------------------------
    st.markdown("<br><br>", unsafe_allow_html=True)
    st.divider()
    st.markdown("## 🎲 Simulaciones Monte Carlo")
    st.markdown("Proyección de la temporada 2025-2026 basada en el rendimiento histórico en la competición.")
    
    # Selectores para elegir el enfrentamiento
    equipos_historicos = df_standings['Team'].tolist()
    col_eq1, col_eq2 = st.columns(2)
    with col_eq1:
        equipo1 = st.selectbox("Equipo Local (Simulación)", equipos_historicos, index=0) # Por defecto: Real Madrid
    with col_eq2:
        equipo2 = st.selectbox("Equipo Visitante (Simulación)", equipos_historicos, index=1) # Por defecto: Bayern Munich
        
    if equipo1 and equipo2 and equipo1 != equipo2:
        # Extraer estadísticas históricas de los equipos seleccionados
        stats1 = df_standings[df_standings['Team'] == equipo1].iloc[0]
        stats2 = df_standings[df_standings['Team'] == equipo2].iloc[0]
        
        # Calcular xG proyectado = (Goles a Favor/Partido propios + Goles en Contra/Partido rival) / 2
        xg1 = (stats1['Goals_For'] / stats1['M.'] + stats2['Goals_Against'] / stats2['M.']) / 2
        xg2 = (stats2['Goals_For'] / stats2['M.'] + stats1['Goals_Against'] / stats1['M.']) / 2
        
        # Ejecutar Simulación Monte Carlo (10,000 iteraciones con Poisson)
        import numpy as np
        num_sims = 10000
        sims_eq1 = np.random.poisson(xg1, num_sims)
        sims_eq2 = np.random.poisson(xg2, num_sims)
        
        # Calcular probabilidades
        vic_1 = (sims_eq1 > sims_eq2).mean() * 100
        vic_2 = (sims_eq2 > sims_eq1).mean() * 100
        empate = (sims_eq1 == sims_eq2).mean() * 100
        
        # Mostrar métricas de la simulación
        st.markdown(f"**xG Proyectado:** {equipo1} **{xg1:.2f}** - **{xg2:.2f}** {equipo2}")
        
        m1, m2, m3 = st.columns(3)
        m1.metric(f"Victoria {equipo1}", f"{vic_1:.1f}%")
        m2.metric("Empate", f"{empate:.1f}%")
        m3.metric(f"Victoria {equipo2}", f"{vic_2:.1f}%")
        
        # Graficar la distribución de la simulación
        import matplotlib.pyplot as plt
        fig_sim, ax_sim = plt.subplots(figsize=(10, 4))
        bins_sim = np.arange(0, 8) - 0.5
        
        ax_sim.hist(sims_eq1, bins=bins_sim, alpha=0.6, label=equipo1, color='#1f77b4', edgecolor='white')
        ax_sim.hist(sims_eq2, bins=bins_sim, alpha=0.6, label=equipo2, color='#d62728', edgecolor='white')
        
        ax_sim.set_xticks(range(7))
        ax_sim.set_xlabel("Goles Anotados")
        ax_sim.set_ylabel("Frecuencia (10,000 Simulaciones)")
        ax_sim.legend()
        
        # Fondo transparente para evitar conflicto con el modo oscuro
        fig_sim.patch.set_alpha(0)
        ax_sim.patch.set_alpha(0)
        ax_sim.xaxis.label.set_color('gray')
        ax_sim.yaxis.label.set_color('gray')
        ax_sim.tick_params(colors='gray')
        
        st.pyplot(fig_sim)

